# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit it.

# Adzuna API credentials (primary job source)
# Sign up free at https://developer.adzuna.com/
ADZUNA_APP_ID=782f250e
ADZUNA_API_KEY=2dd69141f7c563fe4b4329bf9de07f24

# Anthropic API key (used by scorer.py and bio_agent.py)
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Recipient email for the job digest and tailored resumes.
# Alternative to setting recipient_email in config.json — useful for
# shared configs where you don't want a personal email committed.
RECIPIENT_EMAIL=your@email.com
